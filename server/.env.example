# PostgreSQL Database Connection URL
# Local example: "postgresql://postgres:password@localhost:5432/finsight?sslmode=disable"
# Render / Cloud example: "postgresql://user:password@host/database?sslmode=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/finsight?sslmode=disable"

# JWT Secret for authentication tokens (minimum 32 characters, 64-char hex recommended)
JWT_SECRET="generate-a-secure-random-64-character-hex-secret-here"

# Server Port & Environment
PORT=4000
NODE_ENV=development
